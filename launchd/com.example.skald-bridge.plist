<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.example.skald-bridge</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/node</string>
        <string>/Users/YOUR_USER/path/to/skald-tg-bridge/src/bridge.mjs</string>
        <string>--config</string>
        <string>/Users/YOUR_USER/path/to/skald-tg-bridge/config.json</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/YOUR_USER/path/to/skald-tg-bridge</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/YOUR_USER</string>
        <key>PATH</key>
        <string>/Users/YOUR_USER/.kimi-code/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardOutPath</key>
    <string>/Users/YOUR_USER/path/to/skald-tg-bridge/bridge.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/YOUR_USER/path/to/skald-tg-bridge/bridge.err.log</string>
</dict>
</plist>
